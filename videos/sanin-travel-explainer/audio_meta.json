{
  "bgm": {
    "path": "assets/audio/music-bed.wav",
    "volume": 1,
    "source": "host"
  },
  "voices": [
    {
      "frame": 1,
      "path": "assets/voice/01.wav",
      "source": "host",
      "speech_s": 11.382,
      "duration_s": 11.98,
      "words": [
        {
          "text": "一月的日本海",
          "start": 0.0,
          "end": 1.095
        },
        {
          "text": "串起妖怪街",
          "start": 1.317,
          "end": 2.277
        },
        {
          "text": "溫泉和白壁運河",
          "start": 2.538,
          "end": 3.846
        },
        {
          "text": "這趟六人八天的冬日旅行",
          "start": 4.71,
          "end": 6.628
        },
        {
          "text": "從米子進",
          "start": 6.881,
          "end": 7.679
        },
        {
          "text": "岡山出",
          "start": 7.945,
          "end": 8.61
        },
        {
          "text": "把風景和休息一起排進行程",
          "start": 8.855,
          "end": 11.232
        }
      ]
    },
    {
      "frame": 2,
      "path": "assets/voice/02.wav",
      "source": "host",
      "speech_s": 13.88,
      "duration_s": 14.48,
      "words": [
        {
          "text": "先在境港住一晚",
          "start": 0.0,
          "end": 1.379
        },
        {
          "text": "再經米子",
          "start": 1.636,
          "end": 2.385
        },
        {
          "text": "鳥取前往城崎",
          "start": 2.659,
          "end": 3.838
        },
        {
          "text": "連住兩晚",
          "start": 4.126,
          "end": 4.904
        },
        {
          "text": "第四天到天橋立",
          "start": 5.803,
          "end": 7.085
        },
        {
          "text": "第五天折返鳥取",
          "start": 7.359,
          "end": 8.587
        },
        {
          "text": "第六天南下岡山",
          "start": 8.862,
          "end": 10.159
        },
        {
          "text": "最後兩晚以岡山為基地",
          "start": 10.431,
          "end": 12.175
        },
        {
          "text": "安排倉敷一日遊",
          "start": 12.464,
          "end": 13.73
        }
      ]
    },
    {
      "frame": 3,
      "path": "assets/voice/03.wav",
      "source": "host",
      "speech_s": 14.546,
      "duration_s": 15.15,
      "words": [
        {
          "text": "第一天抵達米子",
          "start": 0.0,
          "end": 1.27
        },
        {
          "text": "搭境線前往境港",
          "start": 1.546,
          "end": 3.667
        },
        {
          "text": "先到御宿野乃",
          "start": 3.667,
          "end": 4.766
        },
        {
          "text": "把八件大行李交寄到川口屋",
          "start": 5.003,
          "end": 7.126
        },
        {
          "text": "再去水木茂紀念館和妖怪街散步",
          "start": 7.394,
          "end": 11.014
        },
        {
          "text": "航班若晚到",
          "start": 11.014,
          "end": 11.824
        },
        {
          "text": "寄件優先",
          "start": 12.048,
          "end": 12.874
        },
        {
          "text": "紀念館可以取消",
          "start": 13.117,
          "end": 14.396
        }
      ]
    },
    {
      "frame": 4,
      "path": "assets/voice/04.wav",
      "source": "host",
      "speech_s": 15.371,
      "duration_s": 15.97,
      "words": [
        {
          "text": "第二天輕裝出發",
          "start": 0.0,
          "end": 1.399
        },
        {
          "text": "在米子和鳥取轉乘",
          "start": 1.663,
          "end": 3.201
        },
        {
          "text": "午餐安排在鳥取站區",
          "start": 3.465,
          "end": 5.133
        },
        {
          "text": "再搭特急前往城崎",
          "start": 5.421,
          "end": 6.96
        },
        {
          "text": "入住川口屋後",
          "start": 7.883,
          "end": 9.064
        },
        {
          "text": "外湯選一座就好",
          "start": 9.32,
          "end": 10.576
        },
        {
          "text": "保留更衣與回館時間",
          "start": 10.886,
          "end": 12.502
        },
        {
          "text": "晚上六點享用已確認的旅館晚餐",
          "start": 12.791,
          "end": 15.221
        }
      ]
    },
    {
      "frame": 5,
      "path": "assets/voice/05.wav",
      "source": "host",
      "speech_s": 15.419,
      "duration_s": 16.02,
      "words": [
        {
          "text": "第三天推薦留在城崎慢遊",
          "start": 0.0,
          "end": 2.197
        },
        {
          "text": "天候合適就搭纜車",
          "start": 3.065,
          "end": 4.69
        },
        {
          "text": "風雪大則改平地散步",
          "start": 4.946,
          "end": 6.547
        },
        {
          "text": "午餐後回房休息",
          "start": 7.42,
          "end": 8.86
        },
        {
          "text": "再去外湯泡湯",
          "start": 9.093,
          "end": 10.258
        },
        {
          "text": "這一天還待旅伴拍板",
          "start": 11.035,
          "end": 12.708
        },
        {
          "text": "不把玄武洞或出石加進同一天",
          "start": 12.964,
          "end": 15.269
        }
      ]
    },
    {
      "frame": 6,
      "path": "assets/voice/06.wav",
      "source": "host",
      "speech_s": 14.896,
      "duration_s": 15.5,
      "words": [
        {
          "text": "第四天吃完早餐",
          "start": 0.0,
          "end": 1.446
        },
        {
          "text": "經豐岡轉丹鐵到天橋立",
          "start": 1.682,
          "end": 3.513
        },
        {
          "text": "先寄物",
          "start": 4.419,
          "end": 5.116
        },
        {
          "text": "午餐",
          "start": 5.342,
          "end": 5.812
        },
        {
          "text": "再到展望台看沙洲與松林",
          "start": 6.066,
          "end": 8.036
        },
        {
          "text": "走訪智恩寺",
          "start": 8.29,
          "end": 9.259
        },
        {
          "text": "這天不去伊根",
          "start": 10.137,
          "end": 11.178
        },
        {
          "text": "留時間入住文珠莊",
          "start": 11.476,
          "end": 12.893
        },
        {
          "text": "享用訂房已含的晚餐",
          "start": 13.162,
          "end": 14.746
        }
      ]
    },
    {
      "frame": 7,
      "path": "assets/voice/07.wav",
      "source": "host",
      "speech_s": 17.08,
      "duration_s": 17.68,
      "words": [
        {
          "text": "第五天從天橋立移動到鳥取",
          "start": 0.0,
          "end": 2.296
        },
        {
          "text": "只有八件寄物與巴士接續都順利",
          "start": 3.232,
          "end": 5.801
        },
        {
          "text": "才去砂丘短遊約四十五分鐘",
          "start": 6.106,
          "end": 8.348
        },
        {
          "text": "來不及或風雪大",
          "start": 8.657,
          "end": 10.019
        },
        {
          "text": "就直接到觀水庭休息",
          "start": 10.254,
          "end": 12.004
        },
        {
          "text": "砂之美術館本期展覽到一月三日",
          "start": 12.941,
          "end": 15.581
        },
        {
          "text": "本案不排入館",
          "start": 15.855,
          "end": 16.924
        }
      ]
    },
    {
      "frame": 8,
      "path": "assets/voice/08.wav",
      "source": "host",
      "speech_s": 16.806,
      "duration_s": 17.41,
      "words": [
        {
          "text": "第六天自費吃早餐",
          "start": 0.0,
          "end": 1.587
        },
        {
          "text": "搭特急南下岡山",
          "start": 1.862,
          "end": 3.158
        },
        {
          "text": "先把行李寄放飯店",
          "start": 3.414,
          "end": 4.945
        },
        {
          "text": "午後到吉備津神社",
          "start": 5.856,
          "end": 7.333
        },
        {
          "text": "看沿地形延伸的長廊",
          "start": 7.625,
          "end": 9.256
        },
        {
          "text": "全長三百六十公尺",
          "start": 9.503,
          "end": 11.029
        },
        {
          "text": "不必勉強走完",
          "start": 11.261,
          "end": 12.418
        },
        {
          "text": "傍晚採買後回館",
          "start": 13.316,
          "end": 14.705
        },
        {
          "text": "保留入住和晚餐緩衝",
          "start": 14.963,
          "end": 16.656
        }
      ]
    },
    {
      "frame": 9,
      "path": "assets/voice/09.wav",
      "source": "host",
      "speech_s": 15.259,
      "duration_s": 15.86,
      "words": [
        {
          "text": "第七天輕裝去倉敷",
          "start": 0.0,
          "end": 1.608
        },
        {
          "text": "先看大原美術館",
          "start": 1.858,
          "end": 3.165
        },
        {
          "text": "再逛白壁運河",
          "start": 3.446,
          "end": 4.571
        },
        {
          "text": "美術館冬季下午三點閉館",
          "start": 5.46,
          "end": 7.462
        },
        {
          "text": "所以排在上午",
          "start": 7.715,
          "end": 8.719
        },
        {
          "text": "午後前往 outlet 購物",
          "start": 9.606,
          "end": 11.088
        },
        {
          "text": "傍晚回岡山吃飯休息",
          "start": 11.363,
          "end": 13.096
        },
        {
          "text": "晚上把八件行李整理好",
          "start": 13.356,
          "end": 15.109
        }
      ]
    },
    {
      "frame": 10,
      "path": "assets/voice/10.wav",
      "source": "host",
      "speech_s": 15.908,
      "duration_s": 16.51,
      "words": [
        {
          "text": "最後一天以早餐",
          "start": 0.0,
          "end": 1.452
        },
        {
          "text": "退房和取行李為主",
          "start": 1.71,
          "end": 3.221
        },
        {
          "text": "採用較早的機場巴士安排",
          "start": 3.497,
          "end": 5.427
        },
        {
          "text": "回程已訂下午三點二十五分起飛",
          "start": 6.328,
          "end": 8.843
        },
        {
          "text": "實際巴士班次仍待確認",
          "start": 9.088,
          "end": 10.97
        },
        {
          "text": "早上不硬塞景點",
          "start": 11.878,
          "end": 13.176
        },
        {
          "text": "讓六人八件行李都能從容返家",
          "start": 13.468,
          "end": 15.758
        }
      ]
    },
    {
      "frame": 11,
      "path": "assets/voice/11.wav",
      "source": "host",
      "speech_s": 15.68,
      "duration_s": 16.28,
      "words": [
        {
          "text": "這趟旅行有三個提醒",
          "start": 0.0,
          "end": 1.706
        },
        {
          "text": "八件行李第一天先寄川口屋",
          "start": 2.532,
          "end": 4.59
        },
        {
          "text": "後續寄送仍待決定",
          "start": 4.877,
          "end": 6.282
        },
        {
          "text": "有含餐的住宿依訂房用餐",
          "start": 6.554,
          "end": 8.522
        },
        {
          "text": "其餘餐廳多數尚未訂位",
          "start": 8.745,
          "end": 10.59
        },
        {
          "text": "冬季班次和座位",
          "start": 10.834,
          "end": 12.147
        },
        {
          "text": "出發前再核對",
          "start": 12.402,
          "end": 13.596
        },
        {
          "text": "天候不佳就減少景點",
          "start": 13.867,
          "end": 15.53
        }
      ]
    },
    {
      "frame": 12,
      "path": "assets/voice/12.wav",
      "source": "host",
      "speech_s": 12.984,
      "duration_s": 14.78,
      "words": [
        {
          "text": "從境港的妖怪街",
          "start": 0.0,
          "end": 1.353
        },
        {
          "text": "到城崎的溫泉",
          "start": 1.605,
          "end": 2.756
        },
        {
          "text": "再到倉敷的運河",
          "start": 3.007,
          "end": 4.253
        },
        {
          "text": "把想看的風景排進來",
          "start": 5.131,
          "end": 6.785
        },
        {
          "text": "也把冬天需要的餘裕留下來",
          "start": 7.042,
          "end": 9.027
        },
        {
          "text": "這就是我們的八天七夜",
          "start": 9.901,
          "end": 11.523
        },
        {
          "text": "準備一起出發",
          "start": 11.785,
          "end": 12.834
        }
      ]
    }
  ],
